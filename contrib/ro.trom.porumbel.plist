<?xml version="1.0" encoding="UTF-8"?>
<!-- macOS: cp contrib/ro.trom.porumbel.plist ~/Library/LaunchAgents/
            launchctl load ~/Library/LaunchAgents/ro.trom.porumbel.plist
     Edit the path below to where you put the binary. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>ro.trom.porumbel</string>
  <key>ProgramArguments</key><array><string>/usr/local/bin/porumbel</string></array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ProcessType</key><string>Interactive</string>
</dict>
</plist>
